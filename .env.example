# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Leave empty to run in demo mode (data stored only in your browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Assistente FinHer (server-side only, set in Vercel; never prefix with VITE_).
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5.
ASSISTANT_MODEL=
